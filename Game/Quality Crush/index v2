function stars(){if(movesAtGoal===null)return 0;let ratio=movesAtGoal/initialMoves;return ratio>=.45?3:ratio>=.25?2:1}function wordPanel(){if(!puzzle)return`<section class="card puzzle"><strong>🔎 MOT QUALITÉ MYSTÈRE</strong><p class="muted">Indice après 3 coups réussis : ${Math.min(3,success)}/3.</p></section>`;if(wordResolved)return`<section class="card puzzle ${wordWrong?'wrong':'correct'}"><strong>${wordWrong?'ÉNIGME MANQUÉE':'✓ MOT TROUVÉ'}</strong><h2 class="yellow">${esc(puzzle.w)}</h2><p class="small">${esc(puzzle.m)}</p></section>`;return`<section class="card puzzle"><div class="row between"><strong>🔎 MOT MYSTÈRE</strong><small>Une tentative</small></div><p class="clue">« ${esc(puzzle.c)} »</p><p class="small muted">${Array.from(puzzle.w).length} lettres · Accents conservés</p><div class="slots">${Array.from(puzzle.w).map((_,i)=>`<span class="slot ${i<entry.length?'filled':''} ${i===justFilled?'new':''}">${i<entry.length?esc(letters.find(x=>x.id===entry[i]).letter):'?'}</span>`).join('')}</div>${wordMode?`<div class="row">${btn('VÉRIFIER LE MOT','check',true,entry.length!==Array.from(puzzle.w).length)}${btn('← Effacer','erase',false,!entry.length)}${btn('Tout effacer','clear',false,!entry.length)}</div><div style="margin-top:8px">${btn('REVENIR À LA GRILLE','word')}</div>`:btn('PROPOSER LE MOT','word',true,busy)}<p class="small muted" style="margin-top:9px">La réponse n’est révélée qu’après validation. Une réponse fausse termine l’énigme sans retirer de coup.</p></section>`}
function render(){let focus=document.activeElement?.dataset?.index;if(screen==='home'){app.innerHTML=`<div class="hero"><div><p class="lab">IMPLANTS · CASCADES · CULTURE QUALITÉ</p><h1>QUALITY<br><span>MATCH</span></h1><p class="muted">Aligne les implants d’épaule et résous une énigme qualité différente à chaque tentative.</p><div class="row">${btn('▶ JOUER','play',true)}${btn('COMMENT JOUER','help')}</div><p class="small muted" style="margin-top:12px">28 énigmes · 50 niveaux · 1 tentative par mot</p></div><div class="art">${NAMES.map((n,i)=>`<div style="color:${COLORS[i]}" aria-label="${n}">${icon(i)}</div>`).join('')}</div></div><div class="stats"><div class="stat"><small>Niveau débloqué</small><b>${p.level}/50</b></div><div class="stat"><small>Mots trouvés</small><b>${p.words}</b></div></div><section class="card"><h2>Route qualité</h2><div class="route">${Array.from({length:Math.min(50,Math.max(10,p.level+3))},(_,i)=>i+1).map(l=>`<button class="node ${p.stars[l]?'done':''}" data-action="level" data-level="${l}" ${l>p.level?'disabled':''}>${l}${p.stars[l]?' '+ '★'.repeat(p.stars[l]):''}</button>`).join('')}</div><div class="row between"><small>Progression stockée dans ce navigateur.</small>${btn('Réinitialiser','reset')}</div></section>`;return}
app.innerHTML=`<div class="row between" style="margin-top:15px"><h1 style="font-size:32px;margin:10px 0">QUALITY <span>MATCH</span></h1>${btn('⌂ Accueil','home',false,busy)}</div><p class="small muted">Niveau ${level} · Atteins l’objectif avec le moins de coups possible.</p><div class="layout"><section><div class="stats"><div class="stat"><small>Score / objectif</small><b>${score.toLocaleString('fr-FR')} <small>/ ${goal().toLocaleString('fr-FR')}</small></b></div><div class="stat"><small>Coups restants</small><b>${moves}</b></div></div>${movesAtGoal!==null?`<p class="badge">Objectif franchi avec ${movesAtGoal} coup${movesAtGoal>1?'s':''} restant${movesAtGoal>1?'s':''} · ${'★'.repeat(stars())}</p>`:''}<div class="mobilePuzzle">${wordPanel()}</div><div class="boardbox"><div class="row between" style="margin-bottom:9px"><strong class="small">${wordMode?'Compose ta réponse':'Grille des implants'}</strong><small>${busy?'Cascades…':wordMode?'Indice uniquement':'Échange deux voisins'}</small></div><div class="board ${wordMode?'word':''}" role="group" aria-busy="${busy}">${board.map((x,i)=>{let l=letters.find(z=>z.pos===i&&!entry.includes(z.id));return`<button class="tile ${selected===i?'sel':''} ${pop.includes(i)?'pop':''} ${hint.includes(i)?'hint':''} ${x.special?'special':''} ${l?'hasletter':''}" style="--c:${COLORS[x.kind]}" data-action="tile" data-index="${i}" ${busy?'disabled':''} aria-label="Ligne ${(i>>3)+1}, colonne ${i%8+1}, ${NAMES[x.kind]}${l?', lettre '+l.letter:''}">${icon(x.kind)}${x.special?`<span class="specialMark">${x.special==='row'?'↔':'★'}</span>`:''}${l?`<span class="letter">${l.letter}</span>`:''}</button>`}).join('')}</div></div><div class="message" role="status">${esc(message)}</div><p class="small muted" style="margin-top:9px">Glisse une pièce ou sélectionne deux voisins. Un échange sans alignement est annulé sans coût.</p></section><aside class="stack"><div class="desktopPuzzle">${wordPanel()}</div><section class="card"><h2>Étoiles d’efficacité</h2><p class="small">Calculées selon les coups restants à la fin du niveau :</p><ul class="small"><li>★ : moins de 25 % des coups initiaux restants</li><li>★★ : de 25 % à moins de 45 %</li><li>★★★ : au moins 45 %</li></ul><p class="small muted">La partie s’arrête dès que l’objectif est atteint.</p></section><section class="card"><h2>Bonus</h2><p class="small"><strong class="yellow">↔ Audit de ligne</strong> : alignement de 4.</p><p class="small"><strong class="yellow">★ Golden Implant</strong> : alignement de 5.</p><div class="row">${btn('⚙ Lean +5','lean',false,busy||wordMode||level<20||leanUsed)}${btn('✓ CAPA conseil','capa',false,busy||wordMode||level<30||capaUsed)}</div><p class="small muted" style="margin-top:8px">Lean : niveau 20 · CAPA : niveau 30 · 1 fois par tentative.</p><div></div></section><section class="card"><h2>Implants</h2><div class="legend">${NAMES.map((n,i)=>`<div><span style="color:${COLORS[i]}">${icon(i)}</span>${n}</div>`).join('')}</div></section><div class="row">${btn('↻ Rejouer','restart',false,busy)}</div></aside></div>`;if(focus!==undefined&&!busy)app.querySelector(`[data-index="${focus}"]`)?.focus({preventScroll:true})}
function start(l=p.level){epoch++;level=l;board=fresh();score=0;initialMoves=Math.max(18,25-Math.floor((l-1)/10));moves=initialMoves;movesAtGoal=null;selected=null;success=0;puzzle=null;letters=[];entry=[];wordMode=false;wordResolved=false;wordWrong=false;justFilled=-1;leanUsed=false;capaUsed=false;result=null;pop=[];hint=[];busy=false;screen='game';message='Aligne 3 implants. Une énigme apparaîtra après 3 coups réussis.';close();render();scrollTo(0,0)}function choosePuzzle(){let available=BANK.map((_,i)=>i).filter(i=>!p.recent.includes(i));if(!available.length)available=BANK.map((_,i)=>i);let i=available[Math.floor(Math.random()*available.length)];puzzle=BANK[i];p.recent=[...(p.recent||[]),i].slice(-5);save();let pos=Array.from({length:64},(_,j)=>j);for(let j=63;j>0;j--){let k=Math.floor(Math.random()*(j+1));[pos[j],pos[k]]=[pos[k],pos[j]]}letters=Array.from(puzzle.w).map((letter,j)=>({id:j,letter,pos:pos[j]}));message='Indice disponible. Déduis le mot puis compose ta réponse.';beep('word')}
async function swap(a,b){if(busy||wordMode||result||modal.open||!near(a,b)||moves<=0)return;busy=true;let token=epoch,work=board.slice(),old=work.slice();selected=null;hint=[];[work[a],work[b]]=[work[b],work[a]];board=work;render();await wait(150);if(token!==epoch)return;let forced=null;if(work[a].special==='color'||work[b].special==='color'){let both=work[a].special==='color'&&work[b].special==='color',kind=work[a].special==='color'?work[b].kind:work[a].kind;forced=work.map((x,i)=>both||x.kind===kind||i===a||i===b?i:-1).filter(i=>i>=0)}if(!forced&&!groups(work).length){board=old;busy=false;message='Échange annulé : aucun alignement, aucun coup perdu.';render();return}moves--;let chain=0;while(1){let gs=groups(work);if(!gs.length&&!forced)break;chain++;let removed=new Set(forced||gs.flat()),created=null;if(!forced){let g=gs.reduce((x,y)=>y.length>x.length?y:x,[]);if(g.length>=4){let pos=g.includes(b)?b:g.includes(a)?a:g[0];if(!work[pos].special)created={pos,kind:work[pos].kind,special:g.length>=5?'color':'row'}}}let queue=[...removed],seen=new Set;for(let k=0;k<queue.length;k++){let i=queue[k],x=work[i];if(!x?.special||seen.has(i))continue;seen.add(i);let ex=x.special==='row'?Array.from({length:8},(_,j)=>(i>>3)*8+j):work.map((v,j)=>v.kind===x.kind?j:-1).filter(j=>j>=0);for(let j of ex)if(!removed.has(j)){removed.add(j);queue.push(j)}}let gain=removed.size*40*Math.min(chain,5)+(created?(created.special==='color'?300:150):0);score+=gain;if(movesAtGoal===null&&score>=goal())movesAtGoal=moves;pop=[...removed];message=(chain>1?'COMBO ×'+chain+' · ':'')+'+'+gain+' points';render();beep('match');await wait(220);if(token!==epoch)return;work=work.map((x,i)=>removed.has(i)?null:x);if(created)work[created.pos]={kind:created.kind,special:created.special};work=fall(work);board=work;pop=[];render();forced=null;await wait(140)}success++;if(!possible(work)){board=fresh();message='Grille réorganisée sans perdre de coup.'}busy=false;if(success===3&&!puzzle)choosePuzzle();if(movesAtGoal!==null||moves<=0){render();endLevel();return}render()}
function pick(i){if(busy||result||modal.open)return;if(wordMode){let l=letters.find(x=>x.pos===i&&!entry.includes(x.id));if(!l){message='Choisis une lettre encore disponible.'}else{entry.push(l.id);justFilled=entry.length-1;message='Lettre '+l.letter+' ajoutée. Compose le mot complet avant de vérifier.';beep();flyLetter(i)}render();return}if(selected===null)selected=i;else if(selected===i)selected=null;else if(near(selected,i)){swap(selected,i);return}else{selected=i;message='Choisis une case voisine.'}render()}
function checkWord(){if(!puzzle||entry.length!==Array.from(puzzle.w).length)return;let guess=entry.map(id=>letters.find(x=>x.id===id).letter).join(''),ok=guess===puzzle.w;wordResolved=true;wordMode=false;letters=[];wordWrong=!ok;justFilled=-1;if(ok){score+=500;moves+=3;if(movesAtGoal===null&&score>=goal())movesAtGoal=moves;p.words++;save();message=puzzle.w+' trouvé ! +500 points et +3 coups.';confetti();beep('word');showAnswer(true)}else{message='Énigme terminée. Consulte la réponse attendue.';showAnswer(false)}render()}
function showAnswer(ok){open(ok?'Mot trouvé !':'Réponse incorrecte',`<div class="answer ${ok?'correct':'wrong'}"><p><strong>Indice</strong></p><p>« ${esc(puzzle.c)} »</p><p><strong>Réponse attendue</strong></p><div class="reveal">${esc(puzzle.w)}</div><p>${esc(puzzle.m)}</p>${ok?'<p class="yellow"><strong>+500 points · +3 coups</strong></p>':'<p class="muted">Aucun point et aucun coup retirés.</p>'}</div>${btn('REPRENDRE LA PARTIE','close',true)}`,'answer')}
function flyLetter(i){if(reduced)return;let from=app.querySelector(`[data-index="${i}"]`)?.getBoundingClientRect(),slots=[...app.querySelectorAll('.slot')].filter(x=>x.offsetParent),to=slots[justFilled]?.getBoundingClientRect();if(!from)return;let r=document.createElement('div');r.className='ring';r.style.left=from.left+from.width/2+'px';r.style.top=from.top+from.height/2+'px';document.body.appendChild(r);setTimeout(()=>r.remove(),700);if(!to)return;let f=document.createElement('div');f.className='fly';f.textContent=entry.length?letters.find(x=>x.id===entry[justFilled]).letter:'';f.style.left=from.left+from.width/2-18+'px';f.style.top=from.top+from.height/2-18+'px';f.style.setProperty('--tx',(to.left+to.width/2)-(from.left+from.width/2)+'px');f.style.setProperty('--ty',(to.top+to.height/2)-(from.top+from.height/2)+'px');document.body.appendChild(f);setTimeout(()=>f.remove(),650)}
function confetti(){if(reduced)return;for(let i=0;i<35;i++){let x=document.createElement('i');x.className='confetti';x.style.left=50+Math.random()*10-5+'vw';x.style.top='35vh';x.style.setProperty('--dx',(Math.random()*500-250)+'px');x.style.setProperty('--dy',(Math.random()*420-180)+'px');x.style.background=i%3?'#ffd600':'#fff';document.body.appendChild(x);setTimeout(()=>x.remove(),1000)}}function endLevel(){let win=movesAtGoal!==null,s=stars();if(win){p.level=Math.max(p.level,Math.min(50,level+1));p.best[level]=Math.max(Number(p.best[level])||0,score);p.stars[level]=Math.max(Number(p.stars[level])||0,s);save()}result={end:true,win,score,stars:s};open(win?'Niveau réussi !':'Objectif non atteint',`<div class="stars">${win?'★'.repeat(s)+'☆'.repeat(3-s):'↻'}</div><h2>${score.toLocaleString('fr-FR')} points</h2><p>${win?`Objectif franchi avec <strong>${movesAtGoal}</strong> coup${movesAtGoal>1?'s':''} restant${movesAtGoal>1?'s':''} sur ${initialMoves}.`:'Essaie de créer davantage de cascades et de bonus.'}</p><p class="muted">${win?'La partie s’arrête dès que l’objectif est atteint.':'Tous les coups ont été utilisés.'}</p><div class="stack">${btn(win&&level<50?'NIVEAU SUIVANT':'REJOUER','next',true)}${win?btn('REJOUER CE NIVEAU','again'):''}${btn('ACCUEIL','resultHome')}</div>`,'result')}
function open(title,body,kind){prevFocus=document.activeElement;modal.dataset.kind=kind;modal.innerHTML=`<h2 id="modalTitle">${title}</h2>${body}`;if(!modal.open)modal.showModal();modal.querySelector('button')?.focus()}function close(){if(modal.open)modal.close();prevFocus?.isConnected&&prevFocus.focus()}function help(){open('Comment jouer',`<ul><li>Échange deux voisins pour aligner au moins 3 implants.</li><li>Un échange sans alignement est annulé sans consommer de coup.</li><li>Après 3 coups réussis, un indice et les lettres d’un mot ou acronyme qualité apparaissent.</li><li>Le mot n’est jamais donné. Compose ta réponse puis appuie sur <strong>VÉRIFIER LE MOT</strong>.</li><li>Une mauvaise réponse termine l’énigme et affiche l’indice puis la réponse attendue. Aucun coup ni point n’est retiré.</li><li>Une bonne réponse rapporte 500 points et 3 coups.</li><li>Le niveau s’arrête dès que l’objectif est atteint, après la fin des cascades.</li><li>Plus il reste de coups, plus tu gagnes d’étoiles : moins de 25 %, 25 à 44 %, ou au moins 45 %.</li></ul><p class="small muted">Les mots et définitions sont pédagogiques. Ils ne remplacent pas les procédures applicables.</p>${btn('COMPRIS','close',true)}`,'help')}
document.addEventListener('click',e=>{let b=e.target.closest('[data-action]');if(!b||b.disabled)return;let a=b.dataset.action;if(a==='sound'){sound=!sound;document.getElementById('sound').textContent=sound?'♪ Son activé':'♪ Son coupé';beep();return}if(a==='help'){help();return}if(a==='close'){let k=modal.dataset.kind;close();if(k==='answer'&&movesAtGoal!==null&&!result)endLevel();return}if(busy)return;if(a==='play')start();if(a==='level')start(+b.dataset.level);if(a==='tile'&&Date.now()>=suppress)pick(+b.dataset.index);if(a==='word'){wordMode=!wordMode;selected=null;message=wordMode?'Lis l’indice puis sélectionne les lettres de ta réponse.':'Ta proposition est conservée.';render()}if(a==='erase'){entry.pop();justFilled=-1;render()}if(a==='clear'){entry=[];justFilled=-1;render()}if(a==='check')checkWord();if(['home','restart','reset'].includes(a))confirm(a);if(a==='lean'&&level>=20&&!leanUsed){leanUsed=true;moves+=5;message='Bonus Lean : +5 coups.';render()}if(a==='capa'&&level>=30&&!capaUsed){capaUsed=true;hint=possible(board)||[];message='Conseil CAPA : échange les cases pointillées.';render()}if(a==='confirm'){let t=b.dataset.target;close();if(t==='home'){epoch++;screen='home';render()}if(t==='restart')start(level);if(t==='reset'){p={level:1,best:{},stars:{},words:0,recent:[]};save();screen='home';render()}}if(a==='next')start(result.win&&level<50?level+1:level);if(a==='again')start(level);if(a==='resultHome'){close();screen='home';result=null;render()}});
function confirm(a){open(a==='reset'?'Réinitialiser la progression ?':'Quitter cette tentative ?',`<p>${a==='reset'?'Les niveaux, étoiles et records seront effacés.':'Le score et l’énigme en cours seront perdus.'}</p><div class="row">${btn('ANNULER','close')}${btn('CONFIRMER','confirm',true,false,`data-target="${a}"`)}</div>`,'confirm')}
app.addEventListener('pointerdown',e=>{let t=e.target.closest('[data-action=tile]');if(t&&!wordMode&&!busy){drag={i:+t.dataset.index,x:e.clientX,y:e.clientY};t.setPointerCapture?.(e.pointerId)}});app.addEventListener('pointerup',e=>{let d=drag;drag=null;if(!d||wordMode||busy)return;let dx=e.clientX-d.x,dy=e.clientY-d.y;if(Math.max(Math.abs(dx),Math.abs(dy))<18)return;let j=d.i+(Math.abs(dx)>Math.abs(dy)?dx>0?1:-1:dy>0?8:-8);suppress=Date.now()+400;if(j>=0&&j<64&&near(d.i,j))swap(d.i,j)});app.addEventListener('pointercancel',()=>drag=null);app.addEventListener('keydown',e=>{let t=e.target.closest('[data-action=tile]');if(!t)return;let i=+t.dataset.index,o={ArrowLeft:-1,ArrowRight:1,ArrowUp:-8,ArrowDown:8};if(e.key in o){e.preventDefault();let j=i+o[e.key];if(j>=0&&j<64&&near(i,j))app.querySelector(`[data-index="${j}"]`)?.focus()}if(e.key==='Escape'){selected=null;wordMode=false;render()}});modal.addEventListener('cancel',e=>{if(modal.dataset.kind==='result')e.preventDefault()});window.addEventListener('beforeunload',e=>{if(screen==='game'&&!result){e.preventDefault();e.returnValue=''}});render();
})();</script></body></html>
